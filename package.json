{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "sirargon-wiki",
  "version": "0.0.0",
  "private": true,
  "description": "Multilingual, versioned player wiki content for sirargon.net.",
  "keywords": [
    "documentation",
    "minecraft",
    "sirargon",
    "wiki"
  ],
  "homepage": "https://github.com/sirargonNet/wiki#readme",
  "bugs": {
    "url": "https://github.com/sirargonNet/wiki/issues"
  },
  "license": "UNLICENSED",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sirargonNet/wiki.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm check:policy",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "check:policy": "node scripts/check-policy-parity.ts",
    "skills:update": "pnpm dlx skills@latest update -p -y",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^26.6.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "taze": "^21.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.11.1"
}
